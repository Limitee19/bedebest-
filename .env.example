# Supabase (isi saat mau pindah ke cloud — tanpa ini aplikasi jalan dengan data lokal)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai server (cron push) — JANGAN pakai prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Gemini untuk Rangkuman Cerdas (opsional — tanpa ini rangkuman disusun otomatis lokal)
# Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Web Push agar notifikasi bunyi walau web tertutup (cukup 1x izin di HP)
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:email-kamu@contoh.id

# Rahasia cron harian — string acak panjang, dipakai Vercel Cron → /api/cron/harian
CRON_SECRET=
